{
  "name": "daniel-monroy/sat-estado-cfdi",
  "description": "Paquete interno Laravel para consultar estado CFDI (SAT)",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "sat",
    "cfdi",
    "phpcfdi",
    "facturacion-electronica"
  ],
  "homepage": "https://github.com/DanielMonroy/SatEstadoCFDI",
  "support": {
    "issues": "https://github.com/DanielMonroy/SatEstadoCFDI/issues",
    "source": "https://github.com/DanielMonroy/SatEstadoCFDI"
  },
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "phpcfdi/sat-estado-cfdi": "^2.0",
    "phpcfdi/cfdi-expresiones": "^v3.3.0",
    "guzzlehttp/guzzle": "^7.9",
    "nyholm/psr7": "^1.8",
    "php-http/guzzle7-adapter": "^1.0",
    "ext-dom": "*"
  },
  "autoload": {
    "psr-4": {
      "DanielMonroy\\SatEstadoCfdi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DanielMonroy\\SatEstadoCfdi\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "larastan/larastan": "^3.0",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.9|^11.2",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "conflict": {
    "league/commonmark": ">=2.0.0,<2.8.2",
    "symfony/http-foundation": ">=7.0.0,<7.3.7",
    "symfony/process": ">=7.0.0,<7.3.11"
  },
  "extra": {
    "laravel": {
      "providers": [
        "DanielMonroy\\SatEstadoCfdi\\SatEstadoCfdiServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "lint": "vendor/bin/pint",
    "test": "vendor/bin/pest"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
